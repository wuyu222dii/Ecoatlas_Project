# Backend secrets for local / Render (do not commit real values).
# Local: copy application-local.yml.example → application-local.yml
# Render: set these in the service Environment panel.

# Database (Neon)
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=

# Google Sign-In (OAuth Web Client ID only — no client secret in this app)
GOOGLE_CLIENT_ID=

# Google Places API (New) key
GOOGLE_MAPS_API_KEY=

# Optional
JWT_SECRET=
AI_GEMINI_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_DEFAULT_REDIRECT_URI=http://127.0.0.1:5173/spotify-callback
